{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://maxsmartcity.local/ml/backend/v2/classification-batch.json",
  "title": "Batch category classification v2",
  "oneOf": [
    {
      "type": "object",
      "required": ["contract_version", "batch_id", "items"],
      "properties": {
        "contract_version": {"const": "2.0.0-draft"},
        "batch_id": {"type": "string", "minLength": 1},
        "items": {
          "type": "array",
          "minItems": 1,
          "maxItems": 1024,
          "items": {
            "type": "object",
            "required": ["request_id", "text"],
            "properties": {
              "request_id": {"type": "string", "minLength": 1},
              "text": {"type": "string"},
              "top_k": {"type": "integer", "minimum": 1, "maximum": 20}
            },
            "additionalProperties": false
          }
        }
      },
      "additionalProperties": false
    },
    {
      "type": "object",
      "required": ["batch_id", "items"],
      "properties": {
        "batch_id": {"type": "string"},
        "items": {
          "type": "array",
          "items": {
            "type": "object",
            "required": ["request_id"],
            "properties": {
              "request_id": {"type": ["string", "null"]},
              "response": {"$ref": "classification.schema.json"},
              "error": {"$ref": "error.schema.json"}
            },
            "oneOf": [
              {"required": ["response"], "not": {"required": ["error"]}},
              {"required": ["error"], "not": {"required": ["response"]}}
            ],
            "additionalProperties": false
          }
        }
      },
      "additionalProperties": false
    }
  ]
}
