{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://maxsmartcity.local/contracts/datasets/v1/canonical-scenario.schema.json",
  "title": "Canonical pre-LLM scenario fact",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "scenario_spec_id",
    "taxonomy_version",
    "category_ids",
    "subcategory_id",
    "problem",
    "object_type",
    "severity",
    "organization_type",
    "location",
    "source",
    "source_attributes",
    "context_tags",
    "danger_signals",
    "needs_clarification",
    "ambiguity"
  ],
  "properties": {
    "schema_version": {"const": "canonical-scenario-v1"},
    "scenario_spec_id": {"type": "string", "minLength": 1},
    "taxonomy_version": {"type": "string", "minLength": 1},
    "category_ids": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": {"type": "string", "minLength": 1}
    },
    "subcategory_id": {"type": "string", "minLength": 1},
    "problem": {"type": "string", "minLength": 1},
    "object_type": {"type": "string", "minLength": 1},
    "severity": {"type": "string", "minLength": 1},
    "organization_type": {"type": ["string", "null"]},
    "location": {
      "type": "object",
      "additionalProperties": false,
      "required": ["city_id", "house_id", "street", "house_number", "synthetic"],
      "properties": {
        "city_id": {"type": "string", "minLength": 1},
        "house_id": {"type": "string", "minLength": 1},
        "street": {"type": "string", "minLength": 1},
        "house_number": {"type": "string", "minLength": 1},
        "synthetic": {"const": true}
      }
    },
    "source": {
      "type": "object",
      "additionalProperties": false,
      "required": ["dataset_id", "record_ids", "semantic_key", "occurrence_count"],
      "properties": {
        "dataset_id": {"type": "string", "minLength": 1},
        "record_ids": {
          "type": "array",
          "minItems": 1,
          "items": {"type": "string", "minLength": 1}
        },
        "semantic_key": {"type": "string", "minLength": 1},
        "occurrence_count": {"type": "integer", "minimum": 1}
      }
    },
    "source_attributes": {"type": "object"},
    "context_tags": {"type": "array", "items": {"type": "string"}},
    "danger_signals": {"type": "array", "items": {"type": "string"}},
    "needs_clarification": {"type": "boolean"},
    "ambiguity": {"type": "boolean"}
  }
}
