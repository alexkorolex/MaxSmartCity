{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://maxsmartcity.local/ml/backend/v2/service.json",
  "title": "ML service health, readiness and models",
  "type": "object",
  "properties": {
    "health": {"type": "object", "required": ["status"], "properties": {"status": {"const": "ok"}}},
    "readiness": {
      "type": "object",
      "required": ["ready", "reasons"],
      "properties": {
        "ready": {"type": "boolean"},
        "reasons": {"type": "array", "items": {"type": "string"}}
      }
    },
    "models": {"type": "array", "items": {"type": "object"}}
  }
}
