{
  "version": "extraction-rules-v1",
  "address_patterns": [
    "(?P<value>(?:улиц[аеуы]|ул\\.)\\s+[А-ЯЁA-Z][А-Яа-яЁёA-Za-z-]+\\s*,?\\s*(?:дом|д\\.)\\s*\\d+[А-Яа-яA-Za-z]?)",
    "(?P<value>[А-ЯЁA-Z][А-Яа-яЁёA-Za-z-]+\\s+(?:улиц[аеуы]|проспект[еу]?|переулок)\\s*,?\\s*(?:дом|д\\.)\\s*\\d+[А-Яа-яA-Za-z]?)",
    "(?P<value>(?:на|по адресу)\\s+[А-ЯЁA-Z][А-Яа-яЁёA-Za-z-]+\\s+\\d+[А-Яа-яA-Za-z]?)"
  ],
  "integer_fields": {
    "entrance": ["(?:подъезд|под\\.)\\s*№?\\s*(?P<value>\\d+)"],
    "floor": ["(?:этаж|эт\\.)\\s*№?\\s*(?P<value>\\d+)"]
  },
  "duration_patterns": [
    "(?P<amount>\\d+|один|одна|два|две|три|четыре|пять|пол)\\s*(?P<unit>минут(?:у|ы)?|час(?:а|ов)?|дн(?:я|ей)?)"
  ],
  "number_words": {
    "один": 1,
    "одна": 1,
    "два": 2,
    "две": 2,
    "три": 3,
    "четыре": 4,
    "пять": 5,
    "пол": 0.5
  },
  "duration_units_seconds": {
    "минут": 60,
    "час": 3600,
    "дн": 86400
  },
  "scale_hints": {
    "DISTRICT": ["весь район", "по всему району"],
    "MULTIPLE_HOUSES": ["несколько домов", "соседние дома", "по всей улице"],
    "HOUSE": ["весь дом", "во всём доме", "в доме"],
    "ENTRANCE": ["весь подъезд", "в подъезде"],
    "APARTMENT": ["в квартире", "у меня дома"]
  },
  "danger_signals": {
    "OPEN_FLAME": ["открытое пламя", "горит", "пожар"],
    "SMOKE": ["виден дым", "чувствуется дым", "задымлен", "задымлён"],
    "SPARKING": ["искрит", "искрение"],
    "EXPOSED_WIRE": ["огол[её]нн(?:ый|ые) провод", "оборванн(?:ый|ые) провод"],
    "GAS_SMELL": ["запах газа", "пахнет газом"],
    "FLOODING": ["затапливает", "сильный потоп", "вода ль[её]тся"],
    "WATER_NEAR_ELECTRICITY": [
      "вод[аыу].{0,40}(?:электрощит|щиток|провод)",
      "(?:электрощит|щиток|провод).{0,40}вод[аыу]"
    ],
    "STRUCTURAL_RISK": ["трещина раст[её]т", "угроза обрушения", "обрушил"]
  },
  "problem_continues": {
    "false": ["уже устранили", "восстановили", "больше не", "проблема решена"],
    "true": ["до сих пор", "вс[её] ещ[её]", "продолжается", "опять", "снова"]
  }
}
