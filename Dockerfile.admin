# syntax=docker/dockerfile:1

FROM node:22-alpine AS builder

WORKDIR /app

# Install dependencies first so this layer is cached while only app code changes.
COPY admin/package.json admin/package-lock.json ./
RUN npm ci

COPY admin/ .
RUN npm run build


FROM nginxinc/nginx-unprivileged:1.27-alpine AS runtime

# The unprivileged image already runs as a non-root user and points nginx's pid/cache
# paths at /tmp, so it works as-is under a read-only root filesystem + tmpfs /tmp mount.
COPY nginx/admin.conf /etc/nginx/conf.d/default.conf
COPY --from=builder /app/dist /usr/share/nginx/html

EXPOSE 8080

HEALTHCHECK --interval=30s --timeout=3s --start-period=5s --retries=3 \
    CMD ["wget", "-qO-", "http://127.0.0.1:8080/"]
