LITESTAR_APP=src.main:create_app
DATABASE_URL=postgresql+asyncpg://maxsmartcity:maxsmartcity@localhost:5432/maxsmartcity
# Optional integration-test database; use a disposable database only.
# TEST_DATABASE_URL=postgresql+asyncpg://maxsmartcity:maxsmartcity@localhost:5432/maxsmartcity_test
DB_PASSWORD=maxsmartcity
DB_USER=maxsmartcity
DB_NAME=maxsmartcity
DB_PORT=5432

REDIS_URL=redis://localhost:6379/0
REDIS_PORT=6379

MINIO_PORT=9000
MINIO_ROOT_USER=maxsmartcity
# openssl rand -hex 24
MINIO_ROOT_PASSWORD=change-me-minio-root-password
S3_BUCKET=maxsmartcity-reports
# Internal (container-network) endpoint the backend itself uses for uploads.
S3_INTERNAL_ENDPOINT_URL=http://minio:9000
# Public endpoint used only when SIGNING presigned GET URLs, so a browser can actually
# reach them, and so the URL's Host matches what got signed. The dockerized frontend's
# nginx reverse-proxies MinIO at /<S3_BUCKET>/ on the same public origin as everything
# else (nginx/frontend.conf) - point this at that origin, e.g. FRONTEND_PORT below in
# dev, or your real deployed domain in non-local envs. Never point this at MinIO's own
# port directly except for one-off host-machine debugging - it won't be reachable
# through whatever public tunnel/domain fronts the rest of the app (e.g. ngrok, which
# only forwards a single port).
S3_PUBLIC_ENDPOINT_URL=http://localhost:8082

APP_PORT=8000
# Comma-separated origins the frontend is served from, allowed to call the API cross-origin.
# Only needed for the Vite dev server (localhost:5173) - the dockerized frontend below
# talks to the backend same-origin through its own nginx proxy, so CORS doesn't apply to it.
CORS_ALLOWED_ORIGINS=http://localhost:5173
# Dockerized frontend (nginx serving the built app + proxying /api to the backend).
FRONTEND_PORT=8082
# Dockerized staff admin panel (same nginx pattern as the resident frontend above).
ADMIN_PORT=8083
ML_PORT=8001
ML_SERVICE_URL=http://ml-service:8000
ML_MAX_INPUT_CHARACTERS=4000
ML_REQUEST_TIMEOUT_SECONDS=5

LOKI_PORT=3100
# Tempo's own query API (grafana/tempo below); the backend reaches it in-network via
# OTEL_EXPORTER_OTLP_ENDPOINT, set directly on the backend service - not from this file.
TEMPO_PORT=3200
PROMETHEUS_PORT=9090
GRAFANA_PORT=3000
GRAFANA_USER=admin
# Change this before any non-local deployment.
GRAFANA_PASSWORD=admin

KEYCLOAK_PORT=8080
KEYCLOAK_REALM=maxsmartcity
KEYCLOAK_CLIENT_ID=maxsmartcity-backend
# Dev-only secret baked into keycloak/realm-export.json; rotate for anything beyond local dev.
KEYCLOAK_CLIENT_SECRET=maxsmartcity-backend-dev-secret
KEYCLOAK_ADMIN=admin
# Change this before any non-local deployment.
KEYCLOAK_ADMIN_PASSWORD=admin
# Fixes Keycloak's issuer regardless of which network path a client used to reach it.
KEYCLOAK_BASE_URL=http://localhost:8080
# Must equal the token's `iss` claim exactly - KEYCLOAK_BASE_URL + /realms/KEYCLOAK_REALM.
KEYCLOAK_ISSUER=http://localhost:8080/realms/maxsmartcity
# Where the backend itself fetches Keycloak's signing keys from (in-network address).
KEYCLOAK_JWKS_URI=http://keycloak:8080/realms/maxsmartcity/protocol/openid-connect/certs
# Base URL the backend itself uses to call Keycloak (token endpoint, Admin REST API).
KEYCLOAK_INTERNAL_URL=http://keycloak:8080
KEYCLOAK_AUDIENCE=maxsmartcity-backend

# openssl rand -hex 32
RESIDENT_JWT_SECRET=change-me-resident-jwt-secret
# Shared secret the resident bot sends to mint resident tokens; never given to residents.
BOT_SHARED_SECRET=change-me-bot-shared-secret
# Optional. When set, lets POST /auth/staff/register accept this value via the
# X-Bootstrap-Secret header instead of an admin token, so a fresh deployment can create
# its first admin account. Leave unset (or commented out) to require an admin token
# unconditionally, as before - unset it again once you have your first admin.
# STAFF_BOOTSTRAP_SECRET=change-me-staff-bootstrap-secret

# From https://dev.max.ru bot settings; sent as a bare `Authorization: <token>` header.
MAX_BOT_TOKEN=change-me-max-bot-token
# 5-256 chars, letters/digits/_/- only. Compared against X-Max-Bot-Api-Secret on every call.
MAX_WEBHOOK_SECRET=change-me-max-webhook-secret
MAX_API_BASE_URL=https://platform-api2.max.ru
# Public HTTPS (port 443, no self-signed cert) URL MAX should POST updates to. Only needed
# to run `litestar max-subscribe`/`max-unsubscribe`, not for the webhook handler itself.
# The dockerized frontend's nginx proxies `/webhook/max` straight through to the backend
# (nginx/frontend.conf), so this and WEB_APP_LOGIN_URL below can - and in dev, with a
# single ngrok tunnel, should - share the same domain, e.g. one `ngrok http 8082` tunnel:
# MAX_WEBHOOK_PUBLIC_URL=https://<tunnel>/webhook/max, WEB_APP_LOGIN_URL=https://<tunnel>/auth/max.
MAX_WEBHOOK_PUBLIC_URL=https://example.com/webhook/max
# The frontend's login page. The bot appends `?code=<one-time code>` (as a `link` button)
# and also passes it as an `open_app` button's payload; the frontend reads it and calls
# POST /auth/residents/login itself.
WEB_APP_LOGIN_URL=https://app.maxsmartcity.example/auth/max

# How often (seconds) each backend worker delivers queued notifications to management
# companies/HOAs (MAX, e-mail, webhook) and auto-closes resolutions residents didn't
# answer within 3 days. 0 disables the loop.
BACKGROUND_JOBS_INTERVAL_SECONDS=30
# Outgoing mail: the EMAIL notification channel and new staff members' credentials. Optional:
# without SMTP_HOST only that channel fails (and is retried); everything else works.
# SMTP_HOST=smtp.example.com
# SMTP_PORT=587
# SMTP_USERNAME=
# SMTP_PASSWORD=
# SMTP_FROM=noreply@maxsmartcity.example
# SMTP_STARTTLS=true
# Port 465 is implicit TLS (SSL from the first byte) and turns this on by itself; set it
# explicitly only for a non-standard port.
# SMTP_SSL=true
# Staff sign-in page, sent to new employees together with their login and temporary
# password. Defaults to http://localhost:${ADMIN_PORT} in docker-compose.
# ADMIN_PANEL_URL=https://admin.maxsmartcity.example
