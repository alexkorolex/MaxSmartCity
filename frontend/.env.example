# Base URL for API calls. Left as "/api" by default, which the Vite dev server proxies
# to http://localhost:8000 (see vite.config.ts) - no changes needed for local dev.
# VITE_API_BASE_URL=/api

# Optional: deep link that opens the Max Smart City bot in MAX, shown on the
# "not signed in" screen. Leave unset to show text instructions instead.
# VITE_MAX_BOT_URL=
