{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://maxsmartcity.local/contracts/datasets/v1/llm-report-candidate.schema.json",
  "title": "LLM-generated report candidate requiring human review",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "candidate_id",
    "scenario_spec_id",
    "text",
    "style_id",
    "address_included",
    "category_ids",
    "subcategory_id",
    "organization_type",
    "danger_signals",
    "needs_clarification",
    "ambiguity",
    "location",
    "generation",
    "validation_errors",
    "review_status"
  ],
  "properties": {
    "candidate_id": {"type": "string", "minLength": 1},
    "scenario_spec_id": {"type": "string", "minLength": 1},
    "text": {"type": "string", "minLength": 1},
    "style_id": {"type": "string", "minLength": 1},
    "address_included": {"type": "boolean"},
    "category_ids": {"type": "array", "minItems": 1, "items": {"type": "string"}},
    "subcategory_id": {"type": "string", "minLength": 1},
    "organization_type": {"type": ["string", "null"]},
    "danger_signals": {"type": "array", "items": {"type": "string"}},
    "needs_clarification": {"type": "boolean"},
    "ambiguity": {"type": "boolean"},
    "location": {
      "type": "object",
      "additionalProperties": false,
      "required": ["street", "house_number"],
      "properties": {
        "street": {"type": "string"},
        "house_number": {"type": "string"}
      }
    },
    "generation": {
      "type": "object",
      "additionalProperties": false,
      "required": ["source", "model", "response_id", "pass_id", "config_version", "prompt_version"],
      "properties": {
        "source": {"const": "LLM_SYNTHETIC"},
        "model": {"type": "string"},
        "response_id": {"type": "string"},
        "pass_id": {"type": "string"},
        "config_version": {"type": "string"},
        "prompt_version": {"type": "string"}
      }
    },
    "validation_errors": {"type": "array", "items": {"type": "string"}},
    "review_status": {"const": "CANDIDATE_REQUIRES_HUMAN_REVIEW"}
  }
}
