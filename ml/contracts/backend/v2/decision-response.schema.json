{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://maxsmartcity.local/ml/backend/v2/decision-response.json",
  "title": "ML DecisionResponse v2 draft",
  "type": "object",
  "required": [
    "contract_version",
    "request_id",
    "features",
    "incident_ranking",
    "organization_ranking",
    "action_ranking",
    "requires_manual_review",
    "input_truncated",
    "warnings"
  ],
  "properties": {
    "contract_version": {"const": "2.0.0-draft"},
    "request_id": {"type": "string"},
    "category": {
      "oneOf": [
        {"type": "null"},
        {
          "type": "object",
          "required": ["label_id", "score", "score_kind", "source"],
          "properties": {
            "label_id": {"type": "string"},
            "score": {"type": ["number", "null"]},
            "score_kind": {"type": "string"},
            "source": {"type": "string"}
          },
          "additionalProperties": false
        }
      ]
    },
    "features": {"$ref": "#/$defs/extracted_features"},
    "incident_ranking": {"$ref": "#/$defs/ranking"},
    "organization_ranking": {"$ref": "#/$defs/ranking"},
    "action_ranking": {"$ref": "#/$defs/ranking"},
    "requires_manual_review": {"type": "boolean"},
    "input_truncated": {"type": "boolean"},
    "warnings": {"type": "array", "items": {"type": "string"}}
  },
  "$defs": {
    "extracted_features": {
      "type": "object",
      "required": ["values", "missing_fields", "extractor_version"],
      "properties": {
        "values": {
          "type": "object",
          "properties": {
            "raw_address": {"type": "string"},
            "entrance": {"type": "integer", "minimum": 1},
            "floor": {"type": "integer"},
            "duration": {
              "type": "object",
              "required": ["text", "seconds"],
              "properties": {
                "text": {"type": "string"},
                "seconds": {"type": "integer", "minimum": 0}
              },
              "additionalProperties": false
            },
            "scale_hint": {
              "enum": ["APARTMENT", "ENTRANCE", "HOUSE", "MULTIPLE_HOUSES", "DISTRICT"]
            },
            "danger_signals": {"type": "array", "items": {"type": "string"}},
            "problem_continues": {"type": "boolean"}
          },
          "additionalProperties": false
        },
        "missing_fields": {"type": "array", "items": {"type": "string"}},
        "extractor_version": {"type": "string"}
      },
      "additionalProperties": false
    },
    "ranking": {
      "type": "object",
      "required": ["candidates", "abstain", "abstain_reason"],
      "properties": {
        "candidates": {
          "type": "array",
          "items": {
            "type": "object",
            "required": ["id", "score", "reason_codes"],
            "properties": {
              "id": {"type": "string"},
              "score": {"type": "number"},
              "reason_codes": {"type": "array", "items": {"type": "string"}}
            },
            "additionalProperties": false
          }
        },
        "abstain": {"type": "boolean"},
        "abstain_reason": {"type": ["string", "null"]},
        "model": {"type": ["object", "null"]}
      },
      "additionalProperties": false
    }
  },
  "additionalProperties": false
}
