{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://maxsmartcity.local/ml/backend/v2/decision-response.json",
  "title": "ML DecisionResponse v2 draft",
  "type": "object",
  "required": [
    "contract_version",
    "request_id",
    "features",
    "incident_ranking",
    "organization_ranking",
    "action_ranking",
    "requires_manual_review",
    "input_truncated",
    "warnings"
  ],
  "properties": {
    "contract_version": {"const": "2.0.0-draft"},
    "request_id": {"type": "string"},
    "category": {"type": ["object", "null"]},
    "features": {"type": "object"},
    "incident_ranking": {"$ref": "#/$defs/ranking"},
    "organization_ranking": {"$ref": "#/$defs/ranking"},
    "action_ranking": {"$ref": "#/$defs/ranking"},
    "requires_manual_review": {"type": "boolean"},
    "input_truncated": {"type": "boolean"},
    "warnings": {"type": "array", "items": {"type": "string"}}
  },
  "$defs": {
    "ranking": {
      "type": "object",
      "required": ["candidates", "abstain", "abstain_reason"],
      "properties": {
        "candidates": {
          "type": "array",
          "items": {
            "type": "object",
            "required": ["id", "score", "reason_codes"],
            "properties": {
              "id": {"type": "string"},
              "score": {"type": "number"},
              "reason_codes": {"type": "array", "items": {"type": "string"}}
            },
            "additionalProperties": false
          }
        },
        "abstain": {"type": "boolean"},
        "abstain_reason": {"type": ["string", "null"]},
        "model": {"type": ["object", "null"]}
      },
      "additionalProperties": false
    }
  },
  "additionalProperties": false
}
