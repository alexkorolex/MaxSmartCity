# Production-переменные для docker-compose.prod.yml.
# На сервере .env собирается CI/CD (deploy/write-env.sh) из GitHub Variables и Secrets
# окружения `main`; этот файл — только справочник, что и куда заводить.
# Значения не должны содержать одинарных кавычек и переводов строк.

# ---------- GitHub Variables (Settings → Environments → main → Variables) ----------
DOMAIN=maxsmartcity.example
ACME_EMAIL=ops@maxsmartcity.example
DB_USER=maxsmartcity
DB_NAME=maxsmartcity
MINIO_ROOT_USER=maxsmartcity
KEYCLOAK_ADMIN=admin
GRAFANA_USER=admin
STAFF_ADMIN_LOGIN=admin
# STAFF_ADMIN_DISPLAY_NAME=Главный администратор
# STAFF_ADMIN_EMAIL=

# Необязательные (указаны значения по умолчанию)
# KEYCLOAK_REALM=maxsmartcity
# KEYCLOAK_CLIENT_ID=maxsmartcity-backend
# KEYCLOAK_AUDIENCE=maxsmartcity-backend
# KEYCLOAK_DB_NAME=keycloak
# WEB_CONCURRENCY=2
# ML_REQUEST_TIMEOUT_SECONDS=5
# ML_MAX_INPUT_CHARACTERS=4000
# BACKGROUND_JOBS_INTERVAL_SECONDS=30
# MAX_API_BASE_URL=https://platform-api2.max.ru
# MAX_WEBHOOK_PUBLIC_URL=https://frontend.${DOMAIN}/webhook/max
# WEB_APP_LOGIN_URL=https://frontend.${DOMAIN}/auth/max
# ADMIN_PANEL_URL=https://admin.${DOMAIN}
# SMTP_HOST=
# SMTP_PORT=587
# SMTP_FROM=
# SMTP_STARTTLS=true
# SMTP_SSL=
# CORS_ALLOWED_ORIGINS=
# PROMETHEUS_RETENTION=15d
# TRAEFIK_LOG_LEVEL=INFO
# ACME_CA_SERVER=https://acme-staging-v02.api.letsencrypt.org/directory

# Настройки самого пайплайна
# DEPLOY_DIR=/opt/maxsmartcity
# COMPOSE_PROJECT_NAME=maxsmartcity
# IMAGE_PREFIX=maxsmartcity
# DEPLOY_WAIT_TIMEOUT=900
# BUILD_CACHE_TTL=336h
# LOG_RETENTION_DAYS=30
# HOUSES_DATASET_URL=https://storage.yandexcloud.net/massivehousesbryansk/gis_zkh_bryansk_bakhchysarai.json
# HOUSES_IMPORT_ENABLED=true
# HOUSES_IMPORT_BATCH_SIZE=2000
# GEODATA_BASE_URL=https://storage.yandexcloud.net/massivehousesbryansk
# GEODATA_IMPORT_ENABLED=true
# MAP_WORKERS=2

# ---------- GitHub Secrets (Settings → Environments → main → Secrets) ----------
# openssl rand -hex 32 — hex, чтобы пароль не ломал DATABASE_URL
DB_PASSWORD=
MINIO_ROOT_PASSWORD=
KEYCLOAK_ADMIN_PASSWORD=
KEYCLOAK_CLIENT_SECRET=
RESIDENT_JWT_SECRET=
BOT_SHARED_SECRET=
MAX_BOT_TOKEN=
MAX_WEBHOOK_SECRET=
GRAFANA_PASSWORD=
STAFF_BOOTSTRAP_SECRET=
STAFF_ADMIN_PASSWORD=
# SMTP_USERNAME=
# SMTP_PASSWORD=
