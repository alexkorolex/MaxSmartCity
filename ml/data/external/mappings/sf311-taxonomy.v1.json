      "output": {"category_ids": ["waste"], "subcategory_id": "waste_container", "problem": "уличный контейнер для мусора переполнен", "object_type": "waste_container", "organization_type": "ADMINISTRATION", "context_tags": ["source_controlled_vocabulary"]}
    },
    {
      "id": "sf311-litter-receptacle-left-out",
      "match": {"category": "Litter Receptacle Maintenance", "type": "toters_left_out_24x7"},
      "output": {"category_ids": ["waste"], "subcategory_id": "waste_container", "problem": "мусорный контейнер оставлен на улице вне установленного времени вывоза", "object_type": "waste_container", "organization_type": "ADMINISTRATION", "context_tags": ["source_controlled_vocabulary"]}
    },
    {
