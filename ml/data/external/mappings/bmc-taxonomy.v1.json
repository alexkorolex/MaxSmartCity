{
  "version": "bmc-taxonomy-v1",
  "source_dataset": "bmc-synthetic-complaints",
  "taxonomy_version": "city-incidents-draft-v1",
  "rules": [
    {"id": "bmc-pothole", "match": {"complaint_category": "Pothole / Road Damage"}, "output": {"category_ids": ["road_and_yard"], "subcategory_id": "road_damage", "problem": "яма или повреждение дорожного покрытия", "object_type": "road", "organization_type": "ADMINISTRATION", "context_tags": ["source_synthetic"]}},
    {"id": "bmc-water-disruption", "match": {"complaint_category": "Water Supply Disruption"}, "output": {"category_ids": ["water"], "subcategory_id": "water_supply_disruption", "problem": "перебой или полное отсутствие водоснабжения", "object_type": "water_network", "organization_type": "WATER_UTILITY", "context_tags": ["source_synthetic"]}},
    {"id": "bmc-solid-waste", "match": {"complaint_category": "Solid Waste / Garbage"}, "output": {"category_ids": ["waste"], "subcategory_id": "solid_waste", "problem": "мусор не вывезен или скопился", "object_type": "waste_container", "organization_type": "ADMINISTRATION", "context_tags": ["source_synthetic"]}},
    {"id": "bmc-drainage", "match": {"complaint_category": "Drainage Overflow / Flooding"}, "output": {"category_ids": ["city_infrastructure"], "subcategory_id": "drainage_overflow", "problem": "переполнение водоотвода или локальное подтопление", "object_type": "drainage_network", "organization_type": "ADMINISTRATION", "context_tags": ["source_synthetic"]}},
    {"id": "bmc-street-light", "match": {"complaint_category": "Street Light Failure"}, "output": {"category_ids": ["city_infrastructure"], "subcategory_id": "street_lighting", "problem": "не работает уличное освещение", "object_type": "streetlight", "organization_type": "ADMINISTRATION", "context_tags": ["source_synthetic"]}},
    {"id": "bmc-illegal-construction", "match": {"complaint_category": "Illegal Construction"}, "output": {"category_ids": ["building"], "subcategory_id": "illegal_construction", "problem": "предположительно незаконные строительные работы", "object_type": "building", "organization_type": "ADMINISTRATION", "context_tags": ["source_synthetic", "requires_verification"]}},
    {"id": "bmc-encroachment", "match": {"complaint_category": "Encroachment"}, "output": {"category_ids": ["road_and_yard"], "subcategory_id": "public_space_obstruction", "problem": "самовольное занятие или перекрытие общественного пространства", "object_type": "public_space", "organization_type": "ADMINISTRATION", "context_tags": ["source_synthetic", "requires_verification"]}},
    {"id": "bmc-dangerous-tree", "match": {"complaint_category": "Tree Fallen / Dangerous Tree"}, "output": {"category_ids": ["city_infrastructure"], "subcategory_id": "dangerous_tree", "problem": "упавшее или потенциально опасное дерево", "object_type": "tree", "organization_type": "ADMINISTRATION", "context_tags": ["source_synthetic", "potential_danger"]}},
    {"id": "bmc-public-toilet", "match": {"complaint_category": "Public Toilet Condition"}, "output": {"category_ids": ["city_infrastructure"], "subcategory_id": "public_toilet", "problem": "неудовлетворительное состояние общественного туалета", "object_type": "public_toilet", "organization_type": "ADMINISTRATION", "context_tags": ["source_synthetic"]}},
    {"id": "bmc-water-leak", "match": {"complaint_category": "Water Leakage / Pipe Burst"}, "output": {"category_ids": ["water"], "subcategory_id": "pipe_burst", "problem": "утечка воды или прорыв трубы", "object_type": "water_network", "organization_type": "WATER_UTILITY", "context_tags": ["source_synthetic"]}},
    {"id": "bmc-noise-air", "match": {"complaint_category": "Noise / Air Pollution"}, "output": {"category_ids": ["other"], "subcategory_id": "noise_or_air_pollution", "problem": "шум или загрязнение воздуха", "object_type": "public_space", "organization_type": "ADMINISTRATION", "context_tags": ["source_synthetic", "taxonomy_edge"]}},
    {"id": "bmc-stray-animal", "match": {"complaint_category": "Stray Animal Menace"}, "output": {"category_ids": ["other"], "subcategory_id": "stray_animals", "problem": "безнадзорные животные создают проблему в общественном месте", "object_type": "public_space", "organization_type": "ADMINISTRATION", "context_tags": ["source_synthetic", "taxonomy_edge"]}},
    {"id": "bmc-health", "match": {"complaint_category": "Health / Epidemic"}, "output": {"category_ids": ["other"], "subcategory_id": "public_health", "problem": "сообщение о потенциальной санитарно-эпидемиологической проблеме", "object_type": "public_space", "organization_type": "ADMINISTRATION", "context_tags": ["source_synthetic", "taxonomy_edge", "requires_verification"]}}
  ]
}
