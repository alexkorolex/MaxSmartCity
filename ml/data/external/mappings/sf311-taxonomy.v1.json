{
  "version": "sf311-taxonomy-v1",
  "source_dataset": "sf311-recent-cases",
  "taxonomy_version": "city-incidents-draft-v1",
  "rules": [
    {
      "id": "sf311-public-utilities-water",
      "match": {"category": "Request for City Services", "type": "public_utilities_commission", "details": "water"},
      "output": {"category_ids": ["water"], "subcategory_id": "water_service", "problem": "проблема водоснабжения", "object_type": "water_network", "organization_type": "WATER_UTILITY", "context_tags": ["source_controlled_vocabulary"]}
    },
    {
      "id": "sf311-public-utilities-sewer",
      "match": {"category": "Request for City Services", "type": "public_utilities_commission", "details": "sewer"},
      "output": {"category_ids": ["city_infrastructure"], "subcategory_id": "sewer_service", "problem": "проблема канализации", "object_type": "sewer_network", "organization_type": "ADMINISTRATION", "context_tags": ["source_controlled_vocabulary"]}
    },
    {
      "id": "sf311-public-utilities-electric",
      "match": {"category": "Request for City Services", "type": "public_utilities_commission", "details": "electric_service"},
      "output": {"category_ids": ["electricity"], "subcategory_id": "electric_service", "problem": "проблема электроснабжения", "object_type": "electric_network", "organization_type": "POWER_GRID", "context_tags": ["source_controlled_vocabulary"]}
    },
    {
      "id": "sf311-street-cleaning",
      "match": {"category": "Street and Sidewalk Cleaning"},
      "output": {"category_ids": ["waste"], "subcategory_id": "street_waste", "problem": "мусор или загрязнение на улице", "object_type": "street_or_sidewalk", "organization_type": "ADMINISTRATION", "context_tags": ["source_controlled_vocabulary"]}
    },
    {
