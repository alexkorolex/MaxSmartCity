      "match": {"category": "Litter Receptacle Maintenance"},
      "output": {"category_ids": ["waste"], "subcategory_id": "waste_container", "problem": "проблема с уличным контейнером для мусора", "object_type": "waste_container", "organization_type": "ADMINISTRATION", "context_tags": ["source_controlled_vocabulary"]}
    },
    {
