# Copy this file to .env.local and fill the secret locally.
# The CLI reads it internally; do not pass the key as a command-line argument.
# Never commit .env.local or paste the real key into source code, logs or issues.
AITUNNEL_API_KEY=
AITUNNEL_BASE_URL=https://api.aitunnel.ru/v1/
# Optional override. Normally keep it absent so each versioned config selects its model.
# AITUNNEL_MODEL=mistral-medium-3-5
